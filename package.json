{
  "name": "getpdfpress",
  "version": "2.0.0",
  "description": "Professional PDF tools - Compress, merge, split, and convert PDFs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build:css": "node scripts/build-css.js",
    "build": "npm test && npm run build:css",
    "test:content": "node scripts/check-content.cjs",
    "test": "npm run test:content && npm run test:evidence",
    "test:evidence": "node scripts/check-compression-evidence.cjs",
    "test:ui": "node scripts/test-reporting-ui.cjs"
  },
  "keywords": [
    "pdf",
    "compress",
    "merge",
    "split",
    "convert",
    "pdf-tools"
  ],
  "author": "getPDFpress",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "cors": "^2.8.5",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.33.0",
    "pdf2pic": "^3.1.3",
    "axios": "^1.6.0",
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=24.22.1 <25"
  }
}
